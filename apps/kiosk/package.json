{
  "name": "kebabpos-kiosk",
  "version": "1.0.0",
  "description": "Self-service ordering kiosk for Al Taher Kebabs (Windows, Sin-M01 15.6\" portrait)",
  "main": "dist/main/index.js",
  "homepage": "https://github.com/rahin22/POS-Kiosk",
  "repository": {
    "type": "git",
    "url": "https://github.com/rahin22/POS-System.git"
  },
  "author": {
    "name": "Rahin",
    "email": "rahin22@github.com"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win",
    "release:win": "npm run build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "com.altaher.kiosk",
    "productName": "AlTaherKiosk",
    "electronVersion": "28.3.3",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "rahin22",
      "repo": "POS-Kiosk"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "AlTaherKiosk-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "lucide-react": "^0.563.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}
